    {
      "id": "Conferir recusa e validade",
      "name": "Conferir recusa e validade",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const stop=/^(?:sair|stop|parar|cancelar|remover|descadastrar)(?:[.!\\s]|$)|nao (?:quero|desejo|mande|envie|me envie|me mande|quero receber)|pare de (?:enviar|mandar)|retire (?:meu|o meu)|remov[ae] (?:meu|o meu|me)|exclu[ai] (?:meu|o meu|me)/;\nreturn $input.all().map((it,i)=>{\n const job=$('Um por vez').itemMatching(i).json, h=$('Historico').itemMatching(i).json, history=h.body?.messages;\n const globalRefusal=job.channel==='private' && (it.json.statusCode!==200 || !Array.isArray(it.json.body) || it.json.body.length>0);\n const expired=Date.now()>=Date.parse(job.expires_at);\n const unreadable=job.channel==='private' && (h.statusCode!==200 || !Array.isArray(history?.records) || history.pages>1);\n const refused=job.channel==='private' && (history?.records||[]).some(r=>{\n  if(r.key?.fromMe!==false) return false;\n  const text=(r.message?.conversation||r.message?.extendedTextMessage?.text||'').normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').toLowerCase().trim();\n  return stop.test(text);\n });\n return {json:{...job,allow:!expired&&!unreadable&&!refused&&!globalRefusal,provider_status:expired?'expired':unreadable?'history_unavailable':refused?'optout_history':globalRefusal?'optout_or_unavailable':null},pairedItem:{item:i}};\n});"
      }
    },
