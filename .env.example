# ─────────────────────────────────────────────────────────────────────────────
# Sevilha Performance — variáveis de ambiente (configurar no painel do Vercel)
#
#   Vercel → Project → Settings → Environment Variables
#   Marque Production, Preview e Development. Depois faça um redeploy:
#   variáveis novas só valem para deploys feitos DEPOIS de salvá-las.
#
# Este arquivo é só um modelo. Não coloque valores reais aqui — ele vai para o
# Git. Os segredos ficam apenas no Vercel.
# ─────────────────────────────────────────────────────────────────────────────

# ── Meta Ads ────────────────────────────────────────────────────────────────
# Token do dashboard. Usado apenas no servidor (api/meta.js) — nunca chega ao
# navegador. Gere um System User Token com a permissão `ads_read`.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=1676714556216146

# Token separado da Conversions API, usado por api/leads.js no envio de eventos.
META_CAPI_TOKEN=

# ── Planilha de leads ───────────────────────────────────────────────────────
# Planilha "[CENTRAL DE EVENTOS] Sevilha Perfomance"
LEADS_SHEET_ID=1cedv5kfJhdwcySI1KcqQM4jS_LjIPnUhdYv1aU-SMxg

# Abas lidas (gid que aparece na URL da aba):
#   Leads Respondi ............ campanhas [SE] [LEAD]   (formulário da landing page)
#   Leads Formulário Nativo ... campanhas [SE] [FORMS]  (formulário instantâneo do Meta)
LEADS_SHEET_GID_LP=1200600305
LEADS_SHEET_GID_FORMS=1331027312

# Acesso à planilha — opção A (recomendada): Service Account.
# A planilha continua privada; basta compartilhá-la como *Leitor* com o e-mail
# da Service Account. Passo a passo:
#   1. console.cloud.google.com → criar projeto (ou usar um existente)
#   2. Ativar a API "Google Sheets API"
#   3. IAM & Admin → Service Accounts → criar conta → Keys → Add key → JSON
#   4. Copiar client_email e private_key do JSON para as variáveis abaixo
#   5. Compartilhar a planilha com esse client_email (permissão de Leitor)
# A chave é multilinha: cole com os \n literais, entre aspas.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Acesso à planilha — opção B (fallback, sem credencial): CSV publicado.
# Atenção: "Publicar na web" deixa a aba acessível a quem tiver a URL, e essas
# abas contêm nome, e-mail e telefone dos leads. Prefira a opção A.
# Uma URL por aba, separadas por vírgula.
# LEADS_SHEET_CSV_URLS=

# ── RD Station ──────────────────────────────────────────────────────────────
RD_MARKETING_TOKEN=
RD_CRM_TOKEN=

# ── Supabase ────────────────────────────────────────────────────────────────
# Continua recebendo os envios do formulário do site (api/leads.js, api/ab.js).
# O dashboard NÃO lê mais o Supabase — o volume de leads vem da planilha.
SUPABASE_URL=https://hojcntkggnwrvbvmcwxe.supabase.co
SUPABASE_SERVICE_KEY=
